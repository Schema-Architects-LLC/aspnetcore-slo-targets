{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "SchemaArchitects.AspNetCore.Slo": "Debug"
    }
  },
  "AllowedHosts": "*",
  "SloTargets": {
    "ApmId": "APM00000001",
    "DefaultLatencyMs": 300,
    "AdditionalExcludedPaths": [
      "/internal"
    ],
    "Endpoints": [
      {
        "Method": "POST",
        "Route": "/catalogsvc/v1/updateProductStatus",
        "TargetMs": 150
      },
      {
        "Method": "POST",
        "Route": "/catalogsvc/v1/infoProduct",
        "TargetMs": 300
      },
      {
        "Method": "POST",
        "Route": "/catalogsvc/v1/shipProduct",
        "TargetMs": 400
      },
      {
        "Method": "GET",
        "Route": "/api/orders/{id}",
        "TargetMs": 150
      },
      {
        "Route": "/api/reports/monthly",
        "TargetMs": 1200
      }
    ]
  }
}
