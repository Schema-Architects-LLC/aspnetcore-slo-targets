<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- NuGet metadata (shown on nuget.org) -->
    <PackageId>SchemaArchitects.AspNetCore.Slo</PackageId>
    <AssemblyName>SchemaArchitects.AspNetCore.Slo</AssemblyName>
    <RootNamespace>SchemaArchitects.AspNetCore.Slo</RootNamespace>
    <!-- Default for local builds; the release workflow overrides it from the git tag (v1.2.3 => 1.2.3) -->
    <Version>1.0.0</Version>
    <Authors>SchemaArchitects</Authors>
    <Company>SchemaArchitects</Company>
    <Copyright>Copyright (c) 2026 SchemaArchitects</Copyright>
    <Description>ASP.NET Core middleware that standardizes per-endpoint latency SLO targets via appsettings.json and reports them (APM ID, HTTP method, route template, target) to Dynatrace OneAgent with zero SDK dependencies.</Description>
    <PackageTags>aspnetcore;middleware;slo;sre;latency;dynatrace;observability;apm</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/mariojacas/aspnetcore-slo-targets</PackageProjectUrl>
    <RepositoryUrl>https://github.com/mariojacas/aspnetcore-slo-targets</RepositoryUrl>
    <RepositoryType>git</RepositoryType>

    <!-- SourceLink (built into the .NET 8+ SDK): lets consumers step into this source from GitHub while debugging -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>

    <!-- Ship XML docs so consumers get IntelliSense; missing docs on public APIs become build warnings -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <!-- Publish debug symbols alongside the package (.snupkg) -->
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <!-- ASP.NET Core native framework reference -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <!-- Package README shown on the feed's package page -->
  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <!-- Expose internal members exclusively to the test suite -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>SchemaArchitects.AspNetCore.Slo.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
