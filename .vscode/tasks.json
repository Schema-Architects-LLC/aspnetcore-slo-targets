{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build-sample",
      "type": "process",
      "command": "dotnet",
      "args": ["build", "${workspaceFolder}/samples/SloMonitoring.SampleApi/SloMonitoring.SampleApi.csproj"],
      "problemMatcher": "$msCompile",
      "group": "build"
    },
    {
      "label": "test",
      "type": "process",
      "command": "dotnet",
      "args": ["test", "${workspaceFolder}/SloMonitoring.sln"],
      "problemMatcher": "$msCompile",
      "group": { "kind": "test", "isDefault": true }
    }
  ]
}
